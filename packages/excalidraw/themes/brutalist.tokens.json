{
  "$schema": "./tokens.schema.json",
  "$description": "Raw and loud: hard black borders, offset block shadows, monospace, acid accents, no softness anywhere.",
  "$extensions": {
    "com.hypnodroid.draw": {
      "name": "Brutalist",
      "mode": "light",
      "stroke": {
        "width": "bold",
        "roundness": "sharp",
        "arrowhead": "triangle",
        "arrowType": "sharp",
        "fill": "solid"
      },
      "pen": {
        "pressure": false
      },
      "surface": {
        "border": "bold",
        "shadow": "hard"
      },
      "backdrop": {
        "image": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\"><g fill=\"#111\"><circle cx=\"13\" cy=\"21\" r=\"1\" opacity=\".12\"/><circle cx=\"47\" cy=\"8\" r=\".7\" opacity=\".09\"/><circle cx=\"81\" cy=\"17\" r=\"1.2\" opacity=\".07\"/><circle cx=\"29\" cy=\"44\" r=\".8\" opacity=\".1\"/><circle cx=\"64\" cy=\"39\" r=\"1\" opacity=\".08\"/><circle cx=\"92\" cy=\"52\" r=\".6\" opacity=\".12\"/><circle cx=\"9\" cy=\"67\" r=\"1.1\" opacity=\".07\"/><circle cx=\"41\" cy=\"73\" r=\".7\" opacity=\".11\"/><circle cx=\"73\" cy=\"66\" r=\".9\" opacity=\".09\"/><circle cx=\"23\" cy=\"91\" r=\".8\" opacity=\".1\"/><circle cx=\"56\" cy=\"93\" r=\"1.2\" opacity=\".06\"/><circle cx=\"88\" cy=\"84\" r=\".7\" opacity=\".11\"/><circle cx=\"52\" cy=\"57\" r=\".5\" opacity=\".13\"/><circle cx=\"35\" cy=\"26\" r=\".6\" opacity=\".09\"/></g></svg>",
        "export": false
      },
      "extra": ":scope {\n  font-weight: 700;\n}\n\n:scope .frame-breadcrumb {\n  border-radius: 0;\n  text-transform: uppercase;\n}"
    }
  },
  "color": {
    "$type": "color",
    "canvas": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9569, 0.9569, 0.9412],
        "hex": "#f4f4f0"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "hex": "#000000"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.2314, 0],
        "hex": "#ff3b00"
      }
    },
    "panel": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "active": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9098, 1, 0],
        "hex": "#e8ff00"
      }
    },
    "grid": {
      "$value": "{color.ink}"
    },
    "palette": {
      "orange": {
        "$value": "{color.accent}"
      },
      "blue": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0.2784, 1],
          "hex": "#0047ff"
        }
      },
      "green": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0.651, 0.3176],
          "hex": "#00a651"
        }
      },
      "amber": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 0.6235, 0],
          "hex": "#ff9f00"
        }
      },
      "violet": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7686, 0, 1],
          "hex": "#c400ff"
        }
      },
      "gray": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3608, 0.3608, 0.3608],
          "hex": "#5c5c5c"
        }
      },
      "cyan": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0.702, 0.7804],
          "hex": "#00b3c7"
        }
      }
    },
    "note": {
      "acid": {
        "$value": "{color.active}"
      },
      "white": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "hex": "#ffffff"
        }
      },
      "amber": {
        "$value": "{color.palette.amber}"
      },
      "cyan": {
        "$value": "{color.palette.cyan}"
      },
      "concrete": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7686, 0.7686, 0.7373],
          "hex": "#c4c4bc"
        }
      }
    }
  },
  "font": {
    "ui": {
      "$type": "fontFamily",
      "$value": "Cascadia"
    },
    "canvas": {
      "$type": "fontFamily",
      "$value": "Cascadia"
    },
    "size": {
      "$type": "dimension",
      "$value": {
        "value": 18,
        "unit": "px"
      }
    }
  },
  "grid": {
    "minor": {
      "$type": "number",
      "$value": 0.12
    },
    "major": {
      "$type": "number",
      "$value": 0.5
    },
    "style": {
      "$type": "strokeStyle",
      "$value": "dashed"
    }
  },
  "stroke": {
    "roughness": {
      "$type": "number",
      "$value": 0
    }
  },
  "pen": {
    "$type": "number",
    "width": {
      "$value": 2.5
    }
  },
  "surface": {
    "radius": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    }
  },
  "frame": {
    "width": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "alpha": {
      "$type": "number",
      "$value": 1
    },
    "radius": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    }
  }
}
