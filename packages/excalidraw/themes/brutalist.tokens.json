{
  "$schema": "./tokens.schema.json",
  "$description": "Raw and loud: hard black borders, offset block shadows, monospace, acid accents, no softness anywhere.",
  "$extensions": {
    "com.hypnodroid.draw": {
      "name": "Brutalist",
      "mode": "light",
      "stroke": {
        "width": "bold",
        "roundness": "sharp",
        "arrowhead": "triangle",
        "arrowType": "sharp",
        "fill": "solid"
      },
      "pen": {
        "pressure": false
      },
      "surface": {
        "border": "bold",
        "shadow": "hard"
      },
      "extra": ":scope {\n  font-weight: 700;\n}\n\n:scope .frame-breadcrumb {\n  border-radius: 0;\n  text-transform: uppercase;\n}"
    }
  },
  "color": {
    "$type": "color",
    "canvas": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9569, 0.9569, 0.9412],
        "hex": "#f4f4f0"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "hex": "#000000"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.2314, 0],
        "hex": "#ff3b00"
      }
    },
    "panel": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "active": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9098, 1, 0],
        "hex": "#e8ff00"
      }
    },
    "grid": {
      "$value": "{color.ink}"
    },
    "palette": {
      "orange": {
        "$value": "{color.accent}"
      },
      "blue": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0.2784, 1],
          "hex": "#0047ff"
        }
      },
      "green": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0.651, 0.3176],
          "hex": "#00a651"
        }
      },
      "amber": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 0.6235, 0],
          "hex": "#ff9f00"
        }
      },
      "violet": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7686, 0, 1],
          "hex": "#c400ff"
        }
      },
      "gray": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3608, 0.3608, 0.3608],
          "hex": "#5c5c5c"
        }
      },
      "cyan": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0.702, 0.7804],
          "hex": "#00b3c7"
        }
      }
    }
  },
  "font": {
    "ui": {
      "$type": "fontFamily",
      "$value": "Cascadia"
    },
    "canvas": {
      "$type": "fontFamily",
      "$value": "Cascadia"
    },
    "size": {
      "$type": "dimension",
      "$value": {
        "value": 18,
        "unit": "px"
      }
    }
  },
  "grid": {
    "minor": {
      "$type": "number",
      "$value": 0.12
    },
    "major": {
      "$type": "number",
      "$value": 0.5
    },
    "style": {
      "$type": "strokeStyle",
      "$value": "dashed"
    }
  },
  "stroke": {
    "roughness": {
      "$type": "number",
      "$value": 0
    }
  },
  "pen": {
    "$type": "number",
    "width": {
      "$value": 2.5
    }
  },
  "surface": {
    "radius": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    }
  },
  "frame": {
    "width": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "alpha": {
      "$type": "number",
      "$value": 1
    }
  }
}
